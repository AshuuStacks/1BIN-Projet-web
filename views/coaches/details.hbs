<main>
    <section>
        <div class="bioImage">
            <img src="{{coach.picture_path}}" height="650" width="auto" alt="">
        </div>
        <div id="containe-center">
            <div class="titre-bio-page">
                <h1>La biographie de : {{coach.firstname}}</h1>
                <h4>{{coach.biography }}</h4>
                 
             <div id="update-button">
    {{#if (eq coach.email session.user.email)}}
        <td><a href="/coaches/update?user_id={{coach.user_id}}" class="modify-button">Mettre à jour</a></td> 
    {{/if}}
</div>

          
        </div>
        <br>

        <!-- Formulaire de contact modifié -->
        <div class="containerrr" style="background: rgba(191, 213, 183, 0.63);">
        {{#if (eq ./session.connected true)}}
        {{#unless (eq ../coach.status "coach")}}
        <h2>Contactez Notre Coach</h2>
            <form action="formulaire" method="POST">
                 <label for="message">Envoyez un message à  : {{coach.firstname}}</label>
                <div class="form-group">
                    <label for="message">Message :</label>
                    <textarea id="message" name="message" rows="4" required></textarea>
                </div>
        <td><a href="/messages" class="modify-button">Envoyez</a></td> 
            </form>
            {{/unless}}
            {{/if}}
                                     
        </div>

        <!-- Fin du formulaire de contact modifié -->
    </section>
</main>
