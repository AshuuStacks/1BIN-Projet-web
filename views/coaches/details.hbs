<main>
    <section>
        <div class="bioImage">
            <img src="{{coach.picture_path}}" height="400" width="auto" alt="">
        </div>
        <div id="containe-center">
            <div class="titre-bio-page">
                <h1>{{coach.firstname}} {{coach.surname}}</h1>
                 </div>
                <div id="biography-font-size-design"><h4>{{coach.biography }}</h4></div>
             <div id="update-button">
    {{#if (eq coach.email session.user.email)}}
        <td><a href="/coaches/updateBio?user_id={{coach.user_id}}" class="modify-button">Mettre à jour</a></td> 
    {{/if}}
</div>

        </div>
        <br>

        <!-- Formulaire de contact modifié -->
        {{#if ./session.connected}}
             {{#unless (eq session.user.status "coach")}}
                     <div class="containerrr" style="background: rgba(255, 255, 255, 0.279);">

            <h2>Contactez Notre Coach</h2>
            <h4>{{coach.email}}</h4>   
          <form action="/coaches/sendTo" method="POST">
    <div class="form-group">
        <label for="message">Message :</label>
        <textarea id="message" name="message_text" rows="4" required></textarea>
    </div>
 <input type="hidden" name="receiver_id" value="{{coach.user_id }}">
 <input type="hidden" name="user_id" value="{{session.user.user_id}}">  
 <button type="submit" class="modify-button">Envoyer</button>
</form>
        </div>
    </section>
             {{/unless}}
       {{/if}}

       
        <!-- Fin du formulaire de contact modifié -->
</main>
