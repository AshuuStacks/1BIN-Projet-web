<main>
   <fieldset>
    <section class="form-holder-update">
    <form action="/coaches/updateBio" method="post" enctype="multipart/form-data"  class="form-update border p-4">
        <input type="hidden" name="user_id" value="{{coach.user_id}}">
        <div class="form-group">
          <h2 class="title-update">Votre ancienne photo de profile</h2>
          <div class="photo-center">
                      <img src="{{coach.picture_path}}" height="500"  alt="photo de profile">
                      </div>
          <label for="biographie" class="title-in-updates">Biographie :</label>
          <input class="form-control input-biographie" type="text" id="biography" name="biography" placeholder="Emplacement" value="{{coach.biography}}">
        </div>
        
        <div class="form-group">
          <label for="picture" class="title-in-update">Image :</label>
          <input class="form-control input-picture" type="file" id="user_image" name="picture_path">
        </div>
        <input class="btn btn-primary submit-button" type="submit" value="Mettre à jour">
    </form>
    </section>
  </fieldset>
</main>