<main>
    <section>
        <!-- Affichage du message à mettre à jour -->
        <fieldset>
            <section class="form-holder-update">
                <form action="/messages/updateMessage" method="post" enctype="multipart/form-data" class="form-update border p-4">
                    <!-- Champ caché pour l'ID du message -->
                    <input type="hidden" name="message_id" value="{{message.message_id}}">
                         <input type="hidden" name="message_text" value="{{message.message_text}}">

                    <div class="form-group">
                        <h2 class="title-update">Modifier le message</h2>
                        
                        <!-- Champ de texte pour le message -->
                        <label for="message" class="title-in-updates">Nouveau message :</label>
                        <textarea id="message" name="message_textt" rows="5" required>{{message.message_text}}</textarea>
                    </div>
                    
                    <!-- Bouton de soumission -->
                    <input class="btn btn-primary submit-button" type="submit" value="Mettre à jour">
                </form>
            </section>
        </fieldset>
    </section>
</main>
