<main>
    <div class="title-message">
        <h1>Bonjour monsieur l'entraineur ;)</h1>
    </div>
    <div class="message">
        <div class="contenu">
            {{#each messages}}
            <div class="message-instantanée">
                <h2>Message de : {{sender_id}}</h2>  
                <h3>Voici son message : {{message_text}}</h3>
                <br></br>
                {{#if response_text}}
                <h3>Réponse : {{response_text}}</h3>
                {{else}}
                {{#if receiver_id}}
                <form action="/repondre" method="post">
                    <label for="reponse">Votre réponse :</label><br>
                    <textarea id="reponse" name="reponse" rows="4" cols="50"></textarea><br>
                    <input type="submit" value="Envoyer">
                </form>
                {{else}}
                <h3>Réponse : Aucune réponse disponible pour le moment.</h3>
                {{/if}}
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>
    <!-- Ajoutez plus de messages au besoin -->
</main>
