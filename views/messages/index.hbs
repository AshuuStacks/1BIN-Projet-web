<main>
    {{#if errors}}
                <div class="alert alert-danger" role="alert">
                    {{errors}}
                </div>
                {{/if}}    <div class="title-message">
        <h1>Consultez vos messages</h1>
    </div>
    <div class="message">
    <!--  Vérifié que le receiver_id est le même que l'utilisateur connecté !-->
         <div class="contenu">
                
            {{#each messages}}                
            <div class="message-instantanée">
                <h2>Message de : {{firstname}}</h2>  
                <h2>Qui s'adresse à {{receiver_id}}</h2>
                <h3>Voici son message : {{message_text}}</h3>
                <br></br>
                {{#if response_text}}
                <h3>Réponse : {{response_text}}</h3>
                {{else}}
                {{#if receiver_id}}
                <form action="/repondre" method="post">
                    <label for="reponse">Votre réponse :</label><br>
                    <textarea id="reponse" name="reponse" rows="4" cols="50"></textarea><br>
        <td><a href="/messages" class="modify-button">Envoyez</a></td> 
                </form>
                {{else}}
                <h3>Réponse : Aucune réponse disponible pour le moment.</h3>
                {{/if}}
                {{/if}}
            </div>

            {{/each}}
        </div>
    </div>
       

    <!-- Ajoutez plus de messages au besoin -->
</main>
