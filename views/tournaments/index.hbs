<main>
    <body>
          
        <div class="tournament-body">   
            <div class="tournament-title">
            {{#if errors}}
                <div class="alert alert-danger" role="alert">
                    {{errors}}
                </div>
            {{/if}}
                <h1 id="tournament-page-title">Nos tournois de tennis</h1>
                <h5 id="tournament-page-h5">Informations sur les tournois</h5>
                <p id="tournament-page-txt">Bienvenue sur notre page de la liste des tournois de tennis. <br>
                Vous trouverez ci-dessous tous les tournoi disponibles. <br>
                N'hésitez pas à explorer et à choisir un tournoi pour votre partie.
            </p>
                <table class="tournament-list">
                    <thead>
                        <tr>
                        <th>Id du tournoi</th>
                        <th>Nom</th>
                        <th>Date</th>
                        <th>Nombre de partcipants maximum</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each tournamentsTable}}
                        <tr class="tournament-item">
                            <td>{{this.tournament_id}}</td>
                            <td><a style ="color : green;  font-weight: bold" href="/tournaments/details?tournament_id={{this.tournament_id}}">{{this.name}}</a></td>
                            <td>{{this.date_tournament}} </td>
                            <td>{{this.nb_max_participants}} </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </body>
</main>

