
<h2 id="titleDetailsZak">Details d'un tournoi</h2>

<h3 id='tournamentName'>{{tournament.name}}</h3>

<img src="/{{tournament.banner_image_path}}" alt="Tournament image" class="img-tournament">

<table class="detail-tournament">
                    <thead>
                        <tr>
                        <th>Date</th>
                        <th>Coach qui l'a crée</th>
                        <th>Participants maximum</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="tournament-item">
                            <td>{{tournament.date_tournament}}</td>
                            <td>{{tournament.creator}} </td>
                            <td>{{tournament.nb_max_participants}} </td>
                            </tr>
                    </tbody>
                </table>
        
        <h4 id="nbinscrits"> Il y'a {{ getNumberOfRegistrations}} inscrits..<br>
        Ne tardez pas à vous inscrire!</h4>
        
    {{#if session.connected}} 
    <form action="/tournaments/register" method="POST">
                <input id="inscription-btn" type="submit" value="S'inscrire">
<input type="hidden" name="tournament_id" value="{{tournament.tournament_id}}">
                            <input type="hidden" name="user_id" value="{{session.user.user_id}}">
            </form>
    {{/if}}


    {{#if isregister}}
    <form action="/tournaments/unregister" method="POST">
    <button id="desinscription-btn" type="submit" >Se désinscrire</button>
    </form>    
    {{/if}}
  
     

