<h1 id="titleDetailsZak">Details d'un tournoi</h1>


<h4>{{tournament.name}}</h4>

    <img src="/{{tournament.banner_image_path}}" alt="Image of the tournament">


<table id="tableTournament">
        <tr>
            <th>Date</th>
            <th>Coach qui l'a crée </th>
            <th>Nombre max</th>
        </tr>
        {{#each tournamentsTable}}
        <tr>
            <td>{{tournament.date_tournament}}</td>
            <td>{{tournament.creator}} </td>
            <td>{{tournament.nb_max_participants}} </td>
        </tr>
        {{/each}}
        </table>
        

        <p>Il y'a déjà 18 inscrits..<br>
        Ne tardez pas à vous inscrire</p>

        <button value="S'incrire"></button>
        <button value="Se désinscrire"></button>
