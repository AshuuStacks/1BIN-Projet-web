
<h1 id="titleDetailsZak">Details d'un tournoi</h1>

<h4>{{tournament.name}}</h4>

<img src="/{{tournament.banner_image_path}}" alt="Tournament image" class="img-tournament">

<table class="detail-tournament">
                    <thead>
                        <tr>
                        <th>Date</th>
                        <th>Coach qui l'a crée</th>
                        <th>Nombre max</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each tournamentsTable}}
                        <tr class="tournament-item">
                            <td>{{this.date_tournament}}</td>
                            <td>{{this.creator}} </td>
                            <td>{{this.nb_max_participants}} </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
        
        <h4 id="nbinscrits"> Il y'a déjà 18 inscrits..<br>
        Ne tardez pas à vous inscrire</h4>
       
      <button class="inscription-btn">S'inscrire</button>
      <button class="desinscription-btn">Se désincrire</button>


