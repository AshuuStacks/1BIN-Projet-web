<h2 id="titleCreation"> Cher Coachs, vous avez la possibilité de créer un tournoi! </h2>


    <form id='formCreation' method="post" action="/tournaments/create" enctype="multipart/form-data">
        <div>
            <label>Nom du tournoi: </label>
            <input type="text" name="uniqueNameTournament" />
        </div>
<div>
    <label>Date du tournoi : </label>
    <input type="date"
           min="2024-04-25"
           name="dateTournament"
           required />
</div>
         <div>
            <label> Nombre maximum de participants: </label>
            <input type="number" min="1" max="500" step="1" value="1" name="maxPeople" />
        </div>
        <div>
            <label> Image du tournoi : </label>
            <input type="file" name="filename">
        </div>
         <div>
            <label> Coach qui l'a crée: </label>
            <input type="number" min="1" max="3" name="creator" />
        </div>
        <div>
            <input type="submit" value="Créer">
            
        </div>
    </form>


