<main>
    <body>
        <div class="court-body">
            <div class="container-court">
                {{#if errors}}
                <div class="alert alert-danger" role="alert">
                    {{errors}}
                </div>
                {{/if}}
                <h1 id="court-page-title">Nos terrains de tennis</h1> 
            </div>
        </div>
        <figure class="card-container">
            {{#each courts}}
            <article class="card" style="margin: {{#if (eq (arrayLength ../courts) 3)}}10px 5px{{else}}10px 16px{{/if}};">
            <img class="face" style="margin-top: {{#if (eq ../session.user.status "coach")}}15px{{else}}35px{{/if}};" src="{{picture_path}}" alt="Photo de profil">
                <div class="caption">
                    <h2 style="margin-top: {{#if (eq ../session.user.status "coach")}}10px{{else}}16px{{/if}};"><a class="name" style="color: orange; font-weight: bold" href="/courts/details?tennis_court_id={{tennis_court_id}}">{{name}}</a></h2>
                    <blockquote class="quote">Surface : {{flooring_type}}</blockquote>
                    {{#if (eq ../session.user.status "coach")}}
                    <div class="action-container">
                        <a href="/courts/update?tennis_court_id={{tennis_court_id}}" class="modify-button">Mettre à jour</a>
                    </div>
                    {{/if}}
                </div>
            </article>
            {{/each}}
        </figure>    
    </body>
    
    <style>
        .action-container {
                display: flex;
                justify-content: center;
                align-content: center;
                margin-top: 15px; /* Adjust bottom positioning as needed */
        }
         .card-container {
            max-width: 1000px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            scrollbar-width: thin;  
            white-space: nowrap;
            overflow-x: auto;
            border-radius: 10px;
            padding: 10px; /* Add padding for better visualization */
            margin-bottom: 20px; /* Add margin bottom for spacing */
            }
             .card {
            width: 300px;
            height: 400px;
            flex-shrink: 0;
            border-radius: 13px;
            padding: 10px;
            text-align: center;
            display: inline-block;
            background-color: #e7e7e7;
            transition: all 0.5s ease;
            }
            .card .name {
                margin-top: auto;
                font-size: 35px;
                font-style: normal;
                font-weight: 700;
                line-height: normal;
                text-align: center; 
            }
            
             .card .quote {
            font-size: 20px;
            margin: auto;
            font-family: Amaranth;
            font-style: italic;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            white-space: normal;
            background-color: #ffffff;
            border-radius: 50px;
            transition: all 0.5s ease;
            }
             .card .quote:hover {
                box-shadow: 0px 0px 10px 5px #fd000067;
                border-radius: 10px;
                transform: scale(1.01);
            }
            .card .face {
            width: 200px;
            height: 200px;
            flex-shrink: 0;
            border-radius: 50%;
            object-fit: cover;
            transition: all 0.5s ease;
            }
            .card .face:hover {
            box-shadow: 0px 0px 10px 5px #ffffff;
            border-radius: 50%;
            transform: scale(1.1);
            }        
    </style>
</main>