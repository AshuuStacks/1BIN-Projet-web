<main>
    <body>
        <div class="court-body">
            <div class="container-court">
                {{#if errors}}
                <div class="alert alert-danger" role="alert">
                    {{errors}}
                </div>
                {{/if}}
                <h1 id="court-page-title">Nos terrains de tennis</h1>
                <h5 id="court-page-h5">Informations sur les cours</h5>
                <p id="court-page-txt">Bienvenue sur notre page de liste des courts de tennis. <br>
                Vous trouverez ci-dessous tous les courts disponibles. <br>
                N'hésitez pas à explorer et à choisir un court pour votre partie.
            </p>
                <table class="court-list">
                    <thead>
                        <tr>
                        <th>Nom du terrain</th>
                        <th>Surface</th>
                        {{#if (eq session.user.status "coach")}}
                        <th class="action-column">Action</th>
                        {{/if}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#each courts}}
                        <tr class="court-item">
                            <td><a style ="color : orange;  font-weight: bold" href="/courts/details?tennis_court_id={{tennis_court_id}}">{{name}}</a></td>
                            <td>{{flooring_type}}</td>
                            {{#if (eq ../session.user.status "coach")}}
                            <td><a href="/courts/update?tennis_court_id={{tennis_court_id}}" class="modify-button">Mettre à jour</a></td> 
                            {{/if}}
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="card-container"> <!-- Move card container outside of each loop -->
            {{#each courts}}
            <figure class="card">
                <article>
                    <div class="caption">
                        <h2><a style="color: orange; font-weight: bold" href="/courts/details?tennis_court_id={{tennis_court_id}}">{{name}}</a></h2>
                        <blockquote class="quote">Surface : {{flooring_type}}</blockquote>
                    </div>
                </article>
            </figure>
            {{/each}}
        </div>
    </body>
    <style>
         .card-container {
            max-width: 100%; /* Adjust maximum width */
            overflow-x: auto; /* Add horizontal scrollbar if needed */
            display: flex;
            justify-content: center;
            gap: 20px;
            border-radius: 10px;
            padding: 10px; /* Add padding for better visualization */
            margin-bottom: 20px; /* Add margin bottom for spacing */
            }
             .card {
            width: 300px;
            height: 400px;
            flex-shrink: 0;
            border-radius: 13px;
            padding: 10px;
            text-align: center;
            background-color: #D9D9D9;
            transition: all 0.5s ease;
            }
            
             .card .name {
            margin-top: auto;
            font-size: 30px;
            font-style: normal;
            font-weight: 400;
            line-height: normal;
            color: #000;
            text-align: center;
            font-family: Amaranth;
            background-color: #D9D9D9;
            }
            
             .card .quote {
            font-size: 20px;
            margin: auto;
            font-family: Amaranth;
            font-style: italic;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            white-space: normal;
            background-color: #D9D9D9;
            transition: all 0.5s ease;
            }
             .card .quote:hover {
                box-shadow: 0px 0px 10px 5px #ffffff67;
                border-radius: 10px;
                transform: scale(1.1);
            }        
    </style>
</main>