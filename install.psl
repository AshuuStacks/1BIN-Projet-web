# Vérifie si le dossier 'sqlite' existe, sinon le crée
if (-Not (Test-Path sqlite)) {
    New-Item -ItemType Directory -Path sqlite
}

# Télécharge le fichier zip de SQLite et le place dans le dossier 'sqlite'
Invoke-WebRequest -Uri "https://www.sqlite.org/2024/sqlite-amalgamation-3450200.zip" -OutFile "sqlite\sqlite.zip"

# Décompresse le fichier zip dans le dossier 'sqlite'
Expand-Archive -Path "sqlite\sqlite.zip" -DestinationPath "sqlite" -Force

# Compile les fichiers source de SQLite avec cl (doit être installé et configuré dans le PATH)
cl sqlite\sqlite-amalgamation-3450200\shell.c sqlite\sqlite-amalgamation-3450200\sqlite3.c -Fesqlite\sqlite3.exe

# Exécute SQLite et crée la base de données à partir du fichier 'install.sql'
.\sqlite\sqlite3.exe data\project.db < install.sql
if ($LastExitCode -ne 0) {
    Write-Host "La création de la base de données a échoué" -ForegroundColor Red
    exit 1
}

# Installe les dépendances npm
npm install
if ($LastExitCode -ne 0) {
    Write-Host "L'installation des dépendances a échoué" -ForegroundColor Red
    exit 1
}
